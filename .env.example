# Copy to .env for local runs. Never commit real values (.env is gitignored).

# Source calendar member number on freecalend (https://freecalend.com/open/mem<NO>).
SOURCE_MEMBER_NO=231613

# Cloudflare R2 publishing — used by the CI upload step (wrangler).
# In GitHub these are Actions secrets/variables, not a .env file; listed here
# so the required names are discoverable. Not needed for a local dry run.
CLOUDFLARE_API_TOKEN=   # secret: scoped token with R2 read+write
CLOUDFLARE_ACCOUNT_ID=  # secret
R2_BUCKET=              # variable, e.g. rin-tateishi-calendar
R2_OBJECT_KEY=          # variable, e.g. calendar.ics

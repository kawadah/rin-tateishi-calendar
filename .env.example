# Copy to .env for local runs. Never commit real values (.env is gitignored).

# Source calendar member number on freecalend (https://freecalend.com/open/mem<NO>).
SOURCE_MEMBER_NO=231613

# Cloudflare R2 credentials for uploading the generated .ics.
# Used by the CI upload step (wrangler/rclone); not needed for a local dry run.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

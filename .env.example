# Copy to .env for local runs. Never commit real values (.env is gitignored).

# Source calendar member number on freecalend (https://freecalend.com/open/mem<NO>).
SOURCE_MEMBER_NO=231613

# Cloudflare R2 publishing — used by the CI upload step (aws CLI against R2's
# S3-compatible endpoint). In GitHub these are Actions secrets, not a .env file;
# listed here so the required names are discoverable. Not needed for a local
# dry run. The target bucket and object key are hardcoded in publish.yml.
CLOUDFLARE_ACCOUNT_ID=          # secret: used to build the R2 endpoint host
CLOUDFLARE_R2_ACCESS_KEY_ID=    # secret: R2 S3-compatible access key
CLOUDFLARE_R2_SECRET_ACCESS_KEY= # secret: R2 S3-compatible secret key
